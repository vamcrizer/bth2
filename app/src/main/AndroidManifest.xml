<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bth2">
        <activity android:name=".auth.AdminHomeActivity" android:exported="false" />
        <activity android:name=".auth.CustomerHomeActivity" android:exported="false" />
        <activity android:name=".auth.RegisterActivity" android:exported="false" />
        <activity android:name=".auth.LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".admin.fruit.AdminFruitActivity" android:exported="false"
            android:theme="@style/Theme.Bth2.Admin" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".customer.CustomerFruitListActivity"
            android:exported="false" />
        <activity
            android:name=".customer.CustomerFruitDetailActivity"
            android:exported="false"
            android:parentActivityName=".customer.CustomerFruitListActivity" />
        <activity
            android:name=".ui.order.CustomerOrderHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.order.AdminOrderManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.profile.CustomerProfileActivity"
            android:exported="false" />
    </application>

</manifest>
