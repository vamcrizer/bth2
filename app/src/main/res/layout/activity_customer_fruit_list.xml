<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/shop_bg" android:paddingHorizontal="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_catalog_eyebrow" android:textSize="11sp" android:letterSpacing="0.12" android:textColor="@color/shop_green" android:paddingTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shop_catalog_title" android:textSize="28sp" android:fontFamily="serif" android:textColor="@color/shop_ink" android:layout_marginTop="8dp" android:layout_marginBottom="14dp" />
    <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/shop_panel" android:paddingHorizontal="16dp" android:hint="@string/cs_search_hint" android:textSize="15sp" android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true" android:importantForAutofill="no" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="8dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipCategories" android:layout_width="wrap_content" android:layout_height="wrap_content" app:selectionRequired="true" app:singleLine="true" app:singleSelection="true" />
    </HorizontalScrollView>
    <CheckBox android:id="@+id/cbShowExpired" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/cs_show_expired" android:textSize="12sp" android:textColor="@color/shop_muted" />
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="@string/cs_empty" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvFruits" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="24dp" />
</LinearLayout>
